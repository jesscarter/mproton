# Pins for build/mproton-build.sh. Sourced by bash. Every entry is a full
# commit hash, so a build does not move when a branch upstream does.
# Bumping a pin: change the hash, re-run `build/mproton-build.sh`; the
# workspace step notices and re-checks out what changed. Resolve a branch
# head with `git ls-remote <repo> refs/heads/<branch>`.

# athei/mach9: the build and bundle scripts, checked out as work/mach9/scripts.
# The patches in build/mach9-patches/series are made against this commit.
MACH9_REPO=https://github.com/athei/mach9
MACH9_COMMIT=d176766eb013bf0c84770acd313887ef039acdc2   # main, "Add --keep-symbols to bundle-wine.sh"

# athei/wine arm64-patched (wine-11.20 + athei's macOS arm64 series), checked
# out as work/mach9/src. When wine/apply.sh exists, the Proton series is
# applied on top of this commit, or of the one wine/base.ref names.
WINE_REPO=https://github.com/athei/wine
WINE_COMMIT=5959a04b1afe06ea1b119fa622f0b29f408ac8c4    # arm64-patched

# The sources mach9's own scripts clone. mach9 pins these by branch
# (pins/*-src.ref = macos-patched); the workspace step writes these commits
# into those files instead, so every component is fixed.
FEX_COMMIT=61ed60feb24116414ac438535cbcd789dc99fd62           # athei/FEX macos-patched
MESA_COMMIT=4d597245b76aa01bfda433da5e1c95d0e036f045          # athei/mesa macos-patched
DXMT_COMMIT=73cba75ecd2e5f0aed5a7619991f79ecd10062e9          # athei/dxmt macos-patched
VKD3D_PROTON_COMMIT=2ce454c8132c9c81a0a293853a3805841909590b  # athei/vkd3d-proton macos-patched
