From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ziqing Hui <zhui@codeweavers.com>
Date: Fri, 17 Oct 2025 16:31:52 +0800
Subject: [PATCH] HACK: winegstreamer: Add media formats hacks for Okayunyumu.

CW-Bug-Id: #26015
(cherry picked from commit 8fceab6c2187368e6e94b2fc1e62944f4ecb3960)
mproton-resolved: The two init_stream()/reinit_stream() hunks add the game to the enable_opengl list of 80eb9f6e2bd (OpenGL WMReader pipeline, OpenGL group, not carried), so they're left out; the media-format hacks in video_decoder.c, wma_decoder.c and the other wm_reader.c places apply as is.
---
 dlls/winegstreamer/video_decoder.c | 1 +
 dlls/winegstreamer/wm_reader.c     | 3 +++
 dlls/winegstreamer/wma_decoder.c   | 1 +
 3 files changed, 5 insertions(+)

diff --git a/dlls/winegstreamer/video_decoder.c b/dlls/winegstreamer/video_decoder.c
index ffc53cb64dc..1b215909a16 100644
--- a/dlls/winegstreamer/video_decoder.c
+++ b/dlls/winegstreamer/video_decoder.c
@@ -1279,6 +1279,7 @@ static HRESULT WINAPI media_object_SetInputType(IMediaObject *iface, DWORD index
         || !strcmp(sgi, "1097880")
         || !strcmp(sgi, "1230140")
         || !strcmp(sgi, "2515070")
+        || !strcmp(sgi, "3625380")
     ))
     {
         VIDEOINFOHEADER *vih = (VIDEOINFOHEADER *)decoder->dmo_input_type.pbFormat;
diff --git a/dlls/winegstreamer/wm_reader.c b/dlls/winegstreamer/wm_reader.c
index bd51d13c3c2..103cb6fe02d 100644
--- a/dlls/winegstreamer/wm_reader.c
+++ b/dlls/winegstreamer/wm_reader.c
@@ -575,6 +575,7 @@ static HRESULT WINAPI stream_props_GetMediaType(IWMMediaProps *iface, WM_MEDIA_T
     }
     if (format->major_type == WG_MAJOR_TYPE_VIDEO && sgi && (0
         || !strcmp(sgi, "2515070")
+        || !strcmp(sgi, "3625380")
     ))
     {
         codec_format = config->stream->format;
@@ -587,6 +588,7 @@ static HRESULT WINAPI stream_props_GetMediaType(IWMMediaProps *iface, WM_MEDIA_T
         || !strcmp(sgi, "802870")
         || !strcmp(sgi, "1230140")
         || !strcmp(sgi, "2515070")
+        || !strcmp(sgi, "3625380")
     ))
     {
         codec_format = config->stream->format;
@@ -2653,6 +2655,7 @@ static HRESULT WINAPI reader_SetReadStreamSamples(IWMSyncReader2 *iface, WORD st
             || !strcmp(sgi, "1097880")
             || !strcmp(sgi, "1230140")
             || !strcmp(sgi, "2515070")
+            || !strcmp(sgi, "3625380")
             ))
             compressed = FALSE;
     }
diff --git a/dlls/winegstreamer/wma_decoder.c b/dlls/winegstreamer/wma_decoder.c
index fdb07543995..140f1ce73df 100644
--- a/dlls/winegstreamer/wma_decoder.c
+++ b/dlls/winegstreamer/wma_decoder.c
@@ -800,6 +800,7 @@ static HRESULT WINAPI media_object_SetInputType(IMediaObject *iface, DWORD index
         || !strcmp(sgi, "802870")
         || !strcmp(sgi, "1230140")
         || !strcmp(sgi, "2515070")
+        || !strcmp(sgi, "3625380")
     ))
     {
         WAVEFORMATEX *wfx = (WAVEFORMATEX *)decoder->input_type.pbFormat;
