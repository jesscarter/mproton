From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Thu, 9 Nov 2023 17:08:32 -0600
Subject: [PATCH] amd_ags_x64: Try to get version from agsGetVersionNumber() if
 there is no version resource.

CW-Bug-Id: #22976
(cherry picked from commit 91dbceba24d616c60eaa3700a89ef846d0c27065)
---
 dlls/amd_ags_x64/amd_ags_x64_main.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/dlls/amd_ags_x64/amd_ags_x64_main.c b/dlls/amd_ags_x64/amd_ags_x64_main.c
index ad9d007d288..b278f0e2ce6 100644
--- a/dlls/amd_ags_x64/amd_ags_x64_main.c
+++ b/dlls/amd_ags_x64/amd_ags_x64_main.c
@@ -328,6 +328,8 @@ static enum amd_ags_version determine_ags_version(int ags_version)
      */
     enum amd_ags_version ret = AMD_AGS_VERSION_5_4_1;
     WCHAR dllname[MAX_PATH], temp_path[MAX_PATH], temp_name[MAX_PATH];
+    int (WINAPI *pagsGetVersionNumber)(void);
+    HMODULE hnative = NULL;
     DWORD size;
 
     TRACE("ags_version %#x.\n", ags_version);
@@ -353,9 +355,26 @@ static enum amd_ags_version determine_ags_version(int ags_version)
         goto done;
     }
 
-    get_ags_version_from_resource(temp_name, &ret);
+    if (get_ags_version_from_resource(temp_name, &ret))
+        goto done;
+
+    if (!(hnative = LoadLibraryW(temp_name)))
+    {
+        ERR("LoadLibraryW failed for %s.\n", debugstr_w(temp_name));
+        goto done;
+    }
+
+    if ((pagsGetVersionNumber = (void *)GetProcAddress(hnative, "agsGetVersionNumber")))
+    {
+        ags_version = pagsGetVersionNumber();
+        ret = get_version_number(ags_version);
+        TRACE("Got version %#x (%d) from agsGetVersionNumber.\n", ags_version, ret);
+    }
 
 done:
+    if (hnative)
+        FreeLibrary(hnative);
+
     if (*temp_name)
         DeleteFileW(temp_name);
 
