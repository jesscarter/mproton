 dlls/d3dx11_43/async.c        | 483 ++++++++++++++++++++++++++++++++++
 dlls/d3dx11_43/d3dx11_43.spec |   2 +-
 dlls/d3dx11_43/tests/d3dx11.c | 372 ++++++++++++++++++++++++++
 include/d3dx11core.idl        |   2 +
 5 files changed, 859 insertions(+), 2 deletions(-)

diff --git a/dlls/d3dx11_42/d3dx11_42.spec b/dlls/d3dx11_42/d3dx11_42.spec
