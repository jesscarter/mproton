From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Tue, 16 May 2023 12:53:46 +0200
Subject: [PATCH] HACK: ntdll: Enable WINE_ENABLE_GST_LIVE_LATENCY for some
 games.

CW-Bug-Id: #22045
CW-Bug-Id: #22090
(cherry picked from commit 6a3e2f3f2583442baff4349193acf482641893ac)
---
 dlls/ntdll/unix/loader.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 47bc2bd01e6..c6c8554090c 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -2128,6 +2128,15 @@ static void hacks_init(void)
         setenv( "WINESTEAMNOEXEC", "1", 0 );
         break;
     }
+
+    if (sgi && (0
+        || !strcmp(sgi, "1364780") || !strcmp(sgi, "1952120") || !strcmp(sgi, "2154900") /* Street Fighter 6 */
+        || !strcmp(sgi, "1740720") /* Have a Nice Death  */
+    ))
+    {
+        ERR("HACK: setting WINE_ENABLE_GST_LIVE_LATENCY.\n");
+        setenv("WINE_ENABLE_GST_LIVE_LATENCY", "1", 0);
+    }
 }
 
 /***********************************************************************
