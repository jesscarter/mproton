+++ b/dlls/mf/sar.c
@@ -1721,6 +1721,7 @@ static HRESULT check_media_type(IMFMediaType *type, IMFMediaType *current)
 {
     static const GUID *required_attrs[] =
     {
+        &MF_MT_SUBTYPE,
         &MF_MT_AUDIO_SAMPLES_PER_SECOND,
