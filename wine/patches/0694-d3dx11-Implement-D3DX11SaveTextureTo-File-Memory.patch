+                    break;
+
+                case TEXTURE_1D_ARRAY:
+                    hr = d3d11_create_texture_1d(device, 8, 4, 2, save_tests[i].format, D3D11_USAGE_DEFAULT,
+                            D3D11_BIND_SHADER_RESOURCE, 0, 0, (ID3D11Texture1D **)&tex);
+                    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+                    break;
+
+                case TEXTURE_2D:
