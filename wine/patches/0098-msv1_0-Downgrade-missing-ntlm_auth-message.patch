From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrew Eikum <aeikum@codeweavers.com>
Date: Mon, 21 Mar 2022 14:02:30 -0500
Subject: [PATCH] msv1_0: Downgrade missing ntlm_auth message

This appears in almost every log and is almost never actually a problem.

(cherry picked from commit ce0012323dc22768b5565b4eb01403ffb4160825)
---
 dlls/msv1_0/unixlib.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/msv1_0/unixlib.c b/dlls/msv1_0/unixlib.c
index 805a3850854..7e9c8d84a97 100644
--- a/dlls/msv1_0/unixlib.c
+++ b/dlls/msv1_0/unixlib.c
@@ -46,7 +46,7 @@
   extern char **environ;
 #endif
 
-WINE_DECLARE_DEBUG_CHANNEL(winediag);
+WINE_DECLARE_DEBUG_CHANNEL(ntlm);
 
 #define INITIAL_BUFFER_SIZE 200
 
@@ -201,7 +201,7 @@ static NTSTATUS ntlm_fork( void *args )
     {
         ctx->pid = -1;
         write( pipe_in[1], "BH\n", 3 );
-        ERR_(winediag)( "Can't start ntlm_auth (%s). "
+        WARN_(ntlm)( "Can't start ntlm_auth (%s). "
                         "Usually you can find it in the winbind package of your distribution.\n",
                         strerror(err) );
         status = STATUS_UNSUCCESSFUL;
