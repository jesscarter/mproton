Subject: [PATCH] kernelbase: HACK: Force swiftshader for Olympia Rising.

CW-Bug-Id: #22076
(cherry picked from commit 3d3274f56032d07b97381c8793443a8f91c225f1)
---
 dlls/kernelbase/process.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index f969f3e777f..90d868e91df 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -601,6 +601,7 @@ static const WCHAR *hack_append_command_line( const WCHAR *cmd )
     {
         {L"Paradox Launcher.exe", L" --use-gl=swiftshader --in-process-gpu"},
         {L"Montaro\\nw.exe", L" --use-gl=swiftshader"},
+        {L"OlympiaRising.exe", L" --use-gl=swiftshader"},
     };
     unsigned int i;
 
