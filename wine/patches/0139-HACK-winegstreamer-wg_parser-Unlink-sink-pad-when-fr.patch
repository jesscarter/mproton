From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Fri, 12 May 2023 12:20:17 +0200
Subject: [PATCH] HACK: winegstreamer/wg_parser: Unlink sink pad when freeing
 streams.

As a hack as it is should not be necessary, but, sometimes it looks like
the reference leaks.

CW-Bug-Id: #22045
(cherry picked from commit 3120fab7c416f0b7146b9a9b2f708a213fa68e48)
---
 dlls/winegstreamer/wg_parser.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/dlls/winegstreamer/wg_parser.c b/dlls/winegstreamer/wg_parser.c
index c5593ba9c46..5b80960db3e 100644
--- a/dlls/winegstreamer/wg_parser.c
+++ b/dlls/winegstreamer/wg_parser.c
@@ -963,8 +963,14 @@ static struct wg_parser_stream *create_stream(struct wg_parser *parser)
 
 static void free_stream(struct wg_parser_stream *stream)
 {
+    GstPad *peer;
     unsigned int i;
 
+    if ((peer = gst_pad_get_peer(stream->my_sink)))
+    {
+        gst_pad_unlink(peer, stream->my_sink);
+        gst_object_unref(peer);
+    }
     gst_object_unref(stream->my_sink);
 
     if (stream->buffer)
