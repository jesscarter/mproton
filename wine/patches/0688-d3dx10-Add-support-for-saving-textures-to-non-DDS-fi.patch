     return hr;
 }
 
+static HRESULT d3dx10_get_save_format_for_file_format(D3DX10_IMAGE_FILE_FORMAT iff, enum d3dx_pixel_format_id src_fmt,
+        enum d3dx_pixel_format_id *save_fmt)
+{
+    *save_fmt = D3DX_PIXEL_FORMAT_COUNT;
+    switch (iff)
+    {
+        case D3DX10_IFF_JPG:
+            switch (src_fmt)
+            {
+                case D3DX_PIXEL_FORMAT_R8G8B8A8_UNORM:
+                case D3DX_PIXEL_FORMAT_R16G16B16A16_FLOAT:
+                case D3DX_PIXEL_FORMAT_R32G32B32A32_FLOAT:
+                    *save_fmt = D3DX_PIXEL_FORMAT_B8G8R8_UNORM;
+                    break;
+
+                case D3DX_PIXEL_FORMAT_R16_UNORM:
+                    *save_fmt = D3DX_PIXEL_FORMAT_L8_UNORM;
+                    break;
+
+                default:
+                    return E_FAIL;
+            }
+            break;
+
+        case D3DX10_IFF_PNG:
+        case D3DX10_IFF_TIFF:
+            switch (src_fmt)
+            {
+                case D3DX_PIXEL_FORMAT_R8G8B8A8_UNORM:
+                    *save_fmt = D3DX_PIXEL_FORMAT_B8G8R8A8_UNORM;
+                    break;
+
+                case D3DX_PIXEL_FORMAT_R16G16B16A16_FLOAT:
+                case D3DX_PIXEL_FORMAT_R32G32B32A32_FLOAT:
+                    *save_fmt = D3DX_PIXEL_FORMAT_R16G16B16A16_UNORM;
+                    break;
+
+                case D3DX_PIXEL_FORMAT_R16_UNORM:
+                    *save_fmt = D3DX_PIXEL_FORMAT_L16_UNORM;
+                    break;
+
+                default:
+                    return E_FAIL;
+            }
+            break;
+
+        case D3DX10_IFF_BMP:
+            switch (src_fmt)
+            {
+                case D3DX_PIXEL_FORMAT_R8G8B8A8_UNORM:
+                    *save_fmt = D3DX_PIXEL_FORMAT_B8G8R8X8_UNORM;
+                    break;
+
+                case D3DX_PIXEL_FORMAT_R16G16B16A16_FLOAT:
+                case D3DX_PIXEL_FORMAT_R32G32B32A32_FLOAT:
+                case D3DX_PIXEL_FORMAT_R16_UNORM:
+                    FIXME("Encoding of BMP files to WICPixelFormat64bppRGBAFixedPoint unimplemented, using default instead.\n");
+                    *save_fmt = D3DX_PIXEL_FORMAT_B8G8R8X8_UNORM;
+                    break;
+
+                default:
+                    return E_FAIL;
+            }
+            break;
+
+        case D3DX10_IFF_WMP:
+            FIXME("Saving to WMP is currently unimplemented.\n");
+            return E_NOTIMPL;
+
+        default:
+            assert(0);
+            break;
+    }
+
+    return S_OK;
+}
+
+/* Non-DDS formats only hold the first subresource. */
+static HRESULT d3dx10_save_texture_to_image_file(ID3D10Resource *texture, struct d3dx_texture_info *info,
+        D3DX10_IMAGE_FILE_FORMAT format, ID3D10Blob **buffer)
+{
+    enum d3dx_pixel_format_id dst_format;
+    struct d3dx_subresource_data sub_rsrc;
+    struct d3dx_pixels src_pixels;
+    struct d3dx_buffer dst_buffer;
+    ID3D10Resource *staging = NULL;
+    ID3D10Device *device = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = d3dx10_get_save_format_for_file_format(format, info->fmt->format, &dst_format)))
+        return hr;
+
+    ID3D10Resource_GetDevice(texture, &device);
+    hr = d3d10_staging_resource_from_d3dx_texture_info(device, info, FALSE, &staging);
+    if (FAILED(hr))
+        goto exit;
+
+    ID3D10Device_CopySubresourceRegion(device, staging, 0, 0, 0, 0, texture, 0, NULL);
+    hr = d3dx_subresource_data_from_d3d10_staging_resource_map(staging, info->resource_type, FALSE, &sub_rsrc);
+    if (FAILED(hr))
+        goto exit;
+
+    d3dx_pixels_init(sub_rsrc.data, sub_rsrc.row_pitch, sub_rsrc.slice_pitch, NULL, info->fmt->format, 0, 0,
+            info->size.width, info->size.height, 0, 1, &src_pixels);
+    hr = d3dx_save_pixels_to_memory(&src_pixels, info->fmt, (enum d3dx_image_file_format)format, dst_format,
+            &d3dx10_buffer_wrapper, &dst_buffer);
+    d3d10_staging_resource_unmap(staging, info->resource_type);
+    if (SUCCEEDED(hr))
+        *buffer = (ID3D10Blob *)dst_buffer.buffer_iface;
+    else
+        WARN("Failed with hr %#lx.\n", hr);
+
+exit:
+    if (staging)
+        ID3D10Resource_Release(staging);
+    if (device)
+        ID3D10Device_Release(device);
+    return hr;
+}
+
 HRESULT WINAPI D3DX10SaveTextureToMemory(ID3D10Resource *texture, D3DX10_IMAGE_FILE_FORMAT format, ID3D10Blob **buffer,
         UINT flags)
 {
@@ -1765,11 +1885,11 @@ HRESULT WINAPI D3DX10SaveTextureToMemory(ID3D10Resource *texture, D3DX10_IMAGE_F
 
     TRACE("texture %p, format %u, buffer %p, flags %#x.\n", texture, format, buffer, flags);
 
-    if (!texture || !buffer)
+    if (!texture || !buffer || format == D3DX10_IFF_GIF)
         return E_INVALIDARG;
 
     *buffer = NULL;
-    if (format != D3DX10_IFF_DDS)
+    if (format == D3DX10_IFF_WMP)
     {
         FIXME("Saving to file format %u is currently unimplemented.\n", format);
         return E_NOTIMPL;
@@ -1782,6 +1902,12 @@ HRESULT WINAPI D3DX10SaveTextureToMemory(ID3D10Resource *texture, D3DX10_IMAGE_F
         return hr;
     }
 
+    if (format != D3DX10_IFF_DDS && info.resource_type != D3DX_RESOURCE_TYPE_TEXTURE_2D)
+        return E_INVALIDARG;
+
+    if (format != D3DX10_IFF_DDS)
+        return d3dx10_save_texture_to_image_file(texture, &info, format, buffer);
+
     d3dx_rtype = info.resource_type;
     if (d3dx_rtype == D3DX_RESOURCE_TYPE_TEXTURE_2D && d3d10_resource_is_cube_texture(texture))
         d3dx_rtype = D3DX_RESOURCE_TYPE_CUBE_TEXTURE;
