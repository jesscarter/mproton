diff --git a/dlls/d3dx10_43/texture.c b/dlls/d3dx10_43/texture.c
index 72854fad8dc..8275c59789e 100644
--- a/dlls/d3dx10_43/texture.c
+++ b/dlls/d3dx10_43/texture.c
@@ -1642,10 +1642,172 @@ HRESULT WINAPI D3DX10SaveTextureToFileA(ID3D10Resource *texture, D3DX10_IMAGE_FI
     return E_NOTIMPL;
 }
 
+static void d3dx10_buffer_destroy(struct d3dx_buffer *d3dx_buffer)
+{
+    ID3D10Blob *buffer_iface = (ID3D10Blob *)d3dx_buffer->buffer_iface;
+
+    if (buffer_iface)
+        ID3D10Blob_Release(buffer_iface);
+    d3dx_buffer->buffer_iface = d3dx_buffer->buffer_data = NULL;
+}
+
+static HRESULT d3dx10_buffer_create(unsigned int size, struct d3dx_buffer *buffer)
+{
+    ID3D10Blob *buffer_iface;
+    HRESULT hr;
+
+    hr = D3D10CreateBlob(size, &buffer_iface);
+    if (FAILED(hr))
+        return hr;
+
+    buffer->buffer_iface = buffer_iface;
+    buffer->buffer_data = ID3D10Blob_GetBufferPointer(buffer_iface);
+    return S_OK;
+}
+
+static const struct d3dx_buffer_wrapper d3dx10_buffer_wrapper =
+{
+    d3dx10_buffer_create,
+    d3dx10_buffer_destroy,
+    10,
+};
+
+static HRESULT d3dx10_create_dds_file_blob(const struct pixel_format_desc *fmt_desc, enum d3dx_resource_type d3dx_rtype,
+        const struct volume *size, uint32_t mip_levels, uint32_t layers, ID3D10Blob **dst_buffer)
+{
+    struct d3dx_buffer buffer;
+    HRESULT hr;
+
+    *dst_buffer = NULL;
+    hr = d3dx_create_dds_file_blob(fmt_desc->format, NULL, d3dx_rtype, size, mip_levels, layers, &d3dx10_buffer_wrapper,
+            &buffer);
+    if (SUCCEEDED(hr))
+        *dst_buffer = (ID3D10Blob *)buffer.buffer_iface;
+
+    return hr;
+}
+
+static BOOL d3d10_resource_is_cube_texture(ID3D10Resource *rsrc)
+{
+    D3D10_TEXTURE2D_DESC desc;
+    ID3D10Texture2D *tex_2d;
+
+    if (FAILED(ID3D10Resource_QueryInterface(rsrc, &IID_ID3D10Texture2D, (void **)&tex_2d)))
+        return FALSE;
+    ID3D10Texture2D_GetDesc(tex_2d, &desc);
+    ID3D10Texture2D_Release(tex_2d);
+    return !!(desc.MiscFlags & D3D10_RESOURCE_MISC_TEXTURECUBE);
+}
+
+/* Copies each subresource of the texture into the pixels of an image laid out
+ * the same way (layers, then mip levels), through a CPU-readable staging
+ * resource. */
+static HRESULT d3dx_image_from_d3d10_texture(struct d3dx_image *image, struct d3dx_texture_info *info,
+        ID3D10Resource *texture)
+{
+    const struct pixel_format_desc *dst_fmt = get_d3dx_pixel_format_info(image->format);
+    ID3D10Resource *staging = NULL;
+    ID3D10Device *device = NULL;
+    unsigned int i, j;
+    HRESULT hr;
+
+    ID3D10Resource_GetDevice(texture, &device);
+    hr = d3d10_staging_resource_from_d3dx_texture_info(device, info, FALSE, &staging);
+    if (FAILED(hr))
+        goto exit;
+
+    for (i = 0; i < image->layer_count; ++i)
+    {
+        for (j = 0; j < image->mip_levels; ++j)
+        {
+            struct d3dx_pixels src_pixels, dst_pixels;
+            struct d3dx_subresource_data sub_rsrc;
+            struct volume level_size = info->size;
+
+            hr = d3dx_image_get_pixels(image, i, j, &dst_pixels);
+            if (FAILED(hr))
+                goto exit;
+
+            ID3D10Device_CopySubresourceRegion(device, staging, 0, 0, 0, 0, texture, i * info->levels + j, NULL);
+            hr = d3dx_subresource_data_from_d3d10_staging_resource_map(staging, info->resource_type, FALSE, &sub_rsrc);
+            if (FAILED(hr))
+                goto exit;
+
+            d3dx_get_mip_level_size(&level_size, j);
+            d3dx_pixels_init(sub_rsrc.data, sub_rsrc.row_pitch, sub_rsrc.slice_pitch, NULL, info->fmt->format, 0, 0,
+                    level_size.width, level_size.height, 0, level_size.depth, &src_pixels);
+            hr = d3dx_load_pixels_from_pixels(&dst_pixels, dst_fmt, &src_pixels, info->fmt, D3DX10_FILTER_NONE, 0);
+            d3d10_staging_resource_unmap(staging, info->resource_type);
+            if (FAILED(hr))
+            {
+                WARN("Failed with hr %#lx.\n", hr);
+                goto exit;
+            }
+        }
+    }
+
+exit:
+    if (staging)
+        ID3D10Resource_Release(staging);
+    if (device)
+        ID3D10Device_Release(device);
+    return hr;
+}
+
 HRESULT WINAPI D3DX10SaveTextureToMemory(ID3D10Resource *texture, D3DX10_IMAGE_FILE_FORMAT format, ID3D10Blob **buffer,
         UINT flags)
 {
-    FIXME("texture %p, format %u, buffer %p, flags %#x stub!\n", texture, format, buffer, flags);
+    enum d3dx_resource_type d3dx_rtype;
+    struct d3dx_image image = { 0 };
+    struct d3dx_texture_info info;
+    ID3D10Blob *out_buffer = NULL;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("texture %p, format %u, buffer %p, flags %#x.\n", texture, format, buffer, flags);
+
+    if (!texture || !buffer)
+        return E_INVALIDARG;
+
+    *buffer = NULL;
+    if (format != D3DX10_IFF_DDS)
+    {
+        FIXME("Saving to file format %u is currently unimplemented.\n", format);
+        return E_NOTIMPL;
+    }
+
+    if (FAILED(hr = d3dx_texture_info_from_d3d10_resource(texture, &info)))
+    {
+        if (hr == E_NOTIMPL)
+            FIXME("Currently only 2D and 3D texture saving is supported.\n");
+        return hr;
+    }
+
+    d3dx_rtype = info.resource_type;
+    if (d3dx_rtype == D3DX_RESOURCE_TYPE_TEXTURE_2D && d3d10_resource_is_cube_texture(texture))
+        d3dx_rtype = D3DX_RESOURCE_TYPE_CUBE_TEXTURE;
+
+    if ((info.layers > 1 && d3dx_rtype != D3DX_RESOURCE_TYPE_CUBE_TEXTURE)
+            || (d3dx_rtype == D3DX_RESOURCE_TYPE_CUBE_TEXTURE && info.layers > 6))
+    {
+        FIXME("Texture arrays are currently unimplemented.\n");
+        return E_NOTIMPL;
+    }
+
+    hr = d3dx10_create_dds_file_blob(info.fmt, d3dx_rtype, &info.size, info.levels, info.layers, &out_buffer);
+    if (FAILED(hr))
+    {
+        FIXME("Failed to create dds file with hr %#lx.\n", hr);
+        return hr;
+    }
+
+    hr = d3dx_image_init(ID3D10Blob_GetBufferPointer(out_buffer), ID3D10Blob_GetBufferSize(out_buffer), &image, 0,
+            D3DX_IMAGE_SUPPORT_DXT10);
+    if (SUCCEEDED(hr))
+        hr = d3dx_image_from_d3d10_texture(&image, &info, texture);
+
+    if (SUCCEEDED(hr))
+        *buffer = out_buffer;
+    else
+        ID3D10Blob_Release(out_buffer);
+    return SUCCEEDED(hr) ? S_OK : hr;
 }
