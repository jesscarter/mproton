From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Charlotte Pabst <cpabst@codeweavers.com>
Date: Fri, 12 Dec 2025 14:38:44 +0100
Subject: [PATCH] HACK: win32: Emulate NtUserGetAsyncKeyState() recent bit
 in-process.

Avoids a costly wineserver call.

This bit was disabled entirely on previous proton versions,
but this caused issues with a few older games that rely on it.

CW-Bug-Id: #25102
CW-Bug-Id: #25678
(cherry picked from commit 4aa2ab99c594f23a54e83e5a9976f029acb99381)
---
 dlls/win32u/input.c | 22 ++++++++--------------
 1 file changed, 8 insertions(+), 14 deletions(-)

diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index c5f9223dcfe..de9c47e4cdb 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -900,8 +900,9 @@ SHORT WINAPI NtUserGetAsyncKeyState( INT key )
     const desktop_shm_t *desktop_shm;
     struct object_lock lock = OBJECT_LOCK_INIT;
     NTSTATUS status;
-    BYTE state = 0;
+    BYTE prev, state = 0;
     SHORT ret = 0;
+    static LONG prev_keystate[256] = {0};
 
     if (key < 0 || key >= 256) return 0;
 
@@ -911,20 +912,13 @@ SHORT WINAPI NtUserGetAsyncKeyState( INT key )
         state = desktop_shm->keystate[key];
 
     if (status) return 0;
-    if (!(state & 0x40)) return (state & 0x80) << 8;
 
-    /* Need to make a server call to reset the last pressed bit */
-    SERVER_START_REQ( get_key_state )
-    {
-        req->async = 1;
-        req->key = key;
-        if (!wine_server_call( req ))
-        {
-            if (reply->state & 0x40) ret |= 0x0001;
-            if (reply->state & 0x80) ret |= 0x8000;
-        }
-    }
-    SERVER_END_REQ;
+    prev = InterlockedExchange(&prev_keystate[key], state);
+
+    if ((state & 0x80) && !(prev & 0x80))
+        ret |= 0x0001;
+    if (state & 0x80)
+        ret |= 0x8000;
 
     return ret;
 }
