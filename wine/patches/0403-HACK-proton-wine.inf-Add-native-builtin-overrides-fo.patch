Date: Sat, 16 Nov 2024 14:15:14 +0100
Subject: [PATCH] HACK: proton: wine.inf: Add native,builtin overrides for
 msvcrt DLLs.

Squashed with:

wine.inf: Set msvcp140_atomic_wait to native,builtin.

(cherry picked from commit 5cda47551abee1f0d17116953f8e9e44ccfa4e7d)
---
 loader/wine.inf.in | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index b0221f42821..362199a73c7 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -68,6 +68,7 @@ AddReg=\
     Misc,\
     OLE,\
     Printing,\
+    ProtonOverrides,\
     Services, \
     SessionMgr,\
     SteamClient,\
@@ -1384,3 +1385,38 @@ HKCU,Software\Valve\Steam\ActiveProcess,"SteamClientDll",,"%16426%\Steam\steamcl
 HKCU,Software\Valve\Steam\ActiveProcess,"SteamClientDll64",,"%16426%\Steam\steamclient64.dll"
 HKCU,Software\Valve\Steam\ActiveProcess,"SteamPath",,"%16426%\Steam"
 HKLM,Software\Wow6432Node\Valve\Steam,"InstallPath",,"%16422%\Steam"
