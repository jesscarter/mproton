From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Mon, 15 Dec 2025 15:19:03 -0600
Subject: [PATCH] atiadlxx: Get rid of NO_LONG_TYPES.

(cherry picked from commit 98035cc0b5b67faeaabb4dd7b3058870c168eca0)
---
 dlls/atiadlxx/Makefile.in     | 1 -
 dlls/atiadlxx/atiadlxx_main.c | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/dlls/atiadlxx/Makefile.in b/dlls/atiadlxx/Makefile.in
index 85cda94c29d..854aa57b125 100644
--- a/dlls/atiadlxx/Makefile.in
+++ b/dlls/atiadlxx/Makefile.in
@@ -1,4 +1,3 @@
-EXTRADEFS = -DWINE_NO_LONG_TYPES
 MODULE = atiadlxx.dll
 IMPORTS = user32 dxgi cfgmgr32
 
diff --git a/dlls/atiadlxx/atiadlxx_main.c b/dlls/atiadlxx/atiadlxx_main.c
index 788989630de..c85e39ff7ad 100644
--- a/dlls/atiadlxx/atiadlxx_main.c
+++ b/dlls/atiadlxx/atiadlxx_main.c
@@ -51,7 +51,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(atiadlxx);
 
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
-    TRACE("(%p, %u, %p)\n", instance, reason, reserved);
+    TRACE("(%p, %lu, %p)\n", instance, reason, reserved);
 
     switch (reason)
     {
