 include/config.h.in            |  159 +-
 include/wine/server_protocol.h |   19 +-
 include/wine/vulkan.h          |    4 +
 server/request_handlers.h      |   11 +-
 server/request_trace.h         |   11 +-
 6 files changed, 4323 insertions(+), 4538 deletions(-)

