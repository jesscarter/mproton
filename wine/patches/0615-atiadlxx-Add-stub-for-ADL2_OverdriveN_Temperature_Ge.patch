From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Fri, 10 Jul 2026 12:04:32 -0600
Subject: [PATCH] atiadlxx: Add stub for ADL2_OverdriveN_Temperature_Get().

CW-Bug-Id: #27348
(cherry picked from commit f3cd785a53c90da4e80faa4f381fcf766c1eecd8)
---
 dlls/atiadlxx/atiadlxx.spec   | 2 +-
 dlls/atiadlxx/atiadlxx_main.c | 8 ++++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/dlls/atiadlxx/atiadlxx.spec b/dlls/atiadlxx/atiadlxx.spec
index 974bcde1289..7cbcbe8c04e 100644
--- a/dlls/atiadlxx/atiadlxx.spec
+++ b/dlls/atiadlxx/atiadlxx.spec
@@ -548,7 +548,7 @@
 @ stub ADL2_OverdriveN_SystemClocksX2_Set
 @ stub ADL2_OverdriveN_SystemClocks_Get
 @ stub ADL2_OverdriveN_SystemClocks_Set
-@ stub ADL2_OverdriveN_Temperature_Get
+@ cdecl ADL2_OverdriveN_Temperature_Get(ptr long long ptr)
 @ stub ADL2_OverdriveN_Test_Set
 @ stub ADL2_OverdriveN_ThrottleNotification_Get
 @ stub ADL2_OverdriveN_ZeroRPMFan_Get
diff --git a/dlls/atiadlxx/atiadlxx_main.c b/dlls/atiadlxx/atiadlxx_main.c
index abc1a9fdec7..727e6c2dc1d 100644
--- a/dlls/atiadlxx/atiadlxx_main.c
+++ b/dlls/atiadlxx/atiadlxx_main.c
@@ -1170,3 +1170,11 @@ int CDECL ADL2_Overdrive_Caps(ADL_CONTEXT_HANDLE ctx, int adapter_index, int *su
     *version = 0;
     return ADL_ERR_NOT_SUPPORTED;
 }
+
+int CDECL ADL2_OverdriveN_Temperature_Get(ADL_CONTEXT_HANDLE ctx, int adapter_index, int type, int *temperature)
+{
+    FIXME("ctx %p, adapter_index %d, type %d, temperature %p.\n", ctx, adapter_index, type, temperature);
+
+    *temperature = 65000; /* 65C */
+    return ADL_OK;
+}
