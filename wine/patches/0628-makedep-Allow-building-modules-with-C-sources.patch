From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?R=C3=A9mi=20Bernon?= <rbernon@codeweavers.com>
Date: Wed, 21 Oct 2020 17:19:30 +0200
Subject: [PATCH] makedep: Allow building modules with C++ sources.

CW-Bug-Id: #22729
(cherry picked from commit 4aa55a3ae2e9668fcceca0fa29bfe75bc9ff2fd4)

mproton-resolved: 11.20 already compiles C++ sources (FLAG_C_CXX, per-arch CXX); reduced to the missing part: link modules with C++ sources through wineg++ and unixlibs with C++ sources through $(CXX)
---
 tools/makedep.c | 36 +++++++++++++++++++++++++++---------
 1 file changed, 27 insertions(+), 9 deletions(-)

diff --git a/tools/makedep.c b/tools/makedep.c
index 6f16217c6f7..f052811c24a 100644
--- a/tools/makedep.c
+++ b/tools/makedep.c
@@ -169,6 +169,7 @@ static const char *make_xftmpl;
 static const char *sfnt2fon;
 static const char *winebuild;
 static const char *winegcc;
+static const char *winegpp;
 static const char *widl;
 static const char *wrc;
 static const char *wmc;
@@ -2867,9 +2868,9 @@ static const char *cmd_prefix( const char *cmd )
 /*******************************************************************
  *         output_winegcc_command
  */
-static void output_winegcc_command( struct makefile *make, unsigned int arch )
+static void output_winegcc_command( struct makefile *make, unsigned int arch, bool is_cxx )
 {
-    output( "\t%s%s -o $@", cmd_prefix( "CCLD" ), winegcc );
+    output( "\t%s%s -o $@", cmd_prefix( "CCLD" ), is_cxx ? winegpp : winegcc );
     output_filename( strmake( "--wine-objdir %s", root_obj_dir_path( "." ) ) );
     if (tools_dir)
     {
@@ -3578,7 +3579,7 @@ static void output_source_testdll( struct makefile *make, struct incl_file *sour
         output_filename( winebuild );
         output_filename( winegcc );
         output( "\n" );
-        output_winegcc_command( make, link_arch );
+        output_winegcc_command( make, link_arch, false );
         output_filename( "-s" );
         output_filenames( dll_flags );
         if (link_arch) output_filenames( get_expanded_arch_var_array( make, "EXTRADLLFLAGS", link_arch ));
@@ -3924,7 +3925,7 @@ static void output_fake_module( struct makefile *make, const char *spec_file )
     output_filename( winebuild );
     output_filename( winegcc );
     output( "\n" );
-    output_winegcc_command( make, arch );
+    output_winegcc_command( make, arch, false );
     output_filename( "-Wb,--fake-module" );
     if (!make->is_exe) output_filename( "-shared" );
     if (spec_file) output_filename( spec_file );
@@ -3934,6 +3935,22 @@ static void output_fake_module( struct makefile *make, const char *spec_file )
 }
 
 
+/*******************************************************************
+ *         has_cxx_sources
+ */
+static bool has_cxx_sources( const struct makefile *make, bool is_unix )
+{
+    struct incl_file *source;
+
+    LIST_FOR_EACH_ENTRY( source, &make->sources, struct incl_file, entry )
+    {
+        if (!(source->file->flags & FLAG_C_CXX)) continue;
+        if (!!(source->file->flags & FLAG_C_UNIX) == is_unix) return true;
+    }
+    return false;
+}
+
+
 /*******************************************************************
  *         output_module
  */
@@ -4007,9 +4024,9 @@ static void output_module( struct makefile *make, unsigned int arch )
     output_filenames_obj_dir( make, make->res_files[res_arch] );
     output_filenames( dep_libs );
     output_filename( winebuild );
-    output_filename( winegcc );
+    output_filename( has_cxx_sources( make, false ) ? winegpp : winegcc );
     output( "\n" );
-    output_winegcc_command( make, link_arch );
+    output_winegcc_command( make, link_arch, has_cxx_sources( make, false ) );
     if (arch) output_filename( "-Wl,--wine-builtin" );
     if (!make->is_exe) output_filename( "-shared" );
     if (spec_file)
@@ -4092,7 +4109,7 @@ static void output_unix_lib( struct makefile *make )
     output_filenames_obj_dir( make, make->unixobj_files );
     output_filenames( unix_deps );
     output( "\n" );
-    output( "\t%s$(CC) -o $@", cmd_prefix( "CCLD" ));
+    output( "\t%s%s -o $@", cmd_prefix( "CCLD" ), has_cxx_sources( make, true ) ? "$(CXX)" : "$(CC)" );
     output_filenames( get_expanded_make_var_array( make, "UNIXLDFLAGS" ));
     output_filenames_obj_dir( make, make->unixobj_files );
     output_filenames( unix_libs );
@@ -4152,7 +4169,7 @@ static void output_test_module( struct makefile *make, unsigned int arch )
     strarray_add( &make->all_targets[arch], testmodule );
     strarray_add( &make->clean_files, stripped );
     output( "%s:\n", obj_dir_path( make, testmodule ));
-    output_winegcc_command( make, link_arch );
+    output_winegcc_command( make, link_arch, false );
     output_filenames( make->extradllflags );
     output_filenames_obj_dir( make, make->object_files[arch] );
     if (link_arch != arch) output_filenames_obj_dir( make, make->object_files[link_arch] );
@@ -4162,7 +4179,7 @@ static void output_test_module( struct makefile *make, unsigned int arch )
     output_filename( arch_make_variable( "LDFLAGS", link_arch ));
     output( "\n" );
     output( "%s:\n", obj_dir_path( make, stripped ));
-    output_winegcc_command( make, link_arch );
+    output_winegcc_command( make, link_arch, false );
     output_filename( "-s" );
     output_filename( strmake( "-Wb,-F,%s_test.exe", basemodule ));
     output_filenames( make->extradllflags );
@@ -5186,6 +5203,7 @@ int main( int argc, char *argv[] )
     sfnt2fon    = tools_path( "sfnt2fon" );
     winebuild   = tools_path( "winebuild" );
     winegcc     = tools_path( "winegcc" );
+    winegpp     = strmake( "%s/wineg++%s", tools_dir_path( "winegcc" ), tools_ext );
     widl        = tools_path( "widl" );
     wrc         = tools_path( "wrc" );
     wmc         = tools_path( "wmc" );
