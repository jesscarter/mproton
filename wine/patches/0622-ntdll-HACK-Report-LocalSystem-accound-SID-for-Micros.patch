From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Fri, 15 Jul 2022 20:00:08 -0500
Subject: [PATCH] ntdll: HACK: Report LocalSystem accound SID for
 MicrosoftEdgeUpdate.

CW-Bug-Id: #20967
(cherry picked from commit c85e4fa541f8038e888ab02517fb508e2856945a)
---
 dlls/ntdll/unix/loader.c       |  9 +++++++++
 dlls/ntdll/unix/security.c     | 22 ++++++++++++++++++++++
 dlls/ntdll/unix/unix_private.h |  2 ++
 3 files changed, 33 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index c6c8554090c..f0c5d2930d4 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -2114,6 +2114,8 @@ static ULONG_PTR get_image_address(void)
     return 0;
 }
 
+BOOL localsystem_sid;
+
 static void hacks_init(void)
 {
     const char *sgi = getenv( "SteamGameId" );
@@ -2129,6 +2131,13 @@ static void hacks_init(void)
         break;
     }
 
+    if (main_argc > 1 && strstr(main_argv[1], "MicrosoftEdgeUpdate.exe"))
+    {
+        ERR("HACK: reporting LocalSystem account SID.\n");
+        localsystem_sid = TRUE;
+        return;
+    }
+
     if (sgi && (0
         || !strcmp(sgi, "1364780") || !strcmp(sgi, "1952120") || !strcmp(sgi, "2154900") /* Street Fighter 6 */
         || !strcmp(sgi, "1740720") /* Have a Nice Death  */
diff --git a/dlls/ntdll/unix/security.c b/dlls/ntdll/unix/security.c
index 1e1b4f874cf..60c58a77428 100644
--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -391,6 +391,28 @@ NTSTATUS WINAPI NtQueryInformationToken( HANDLE token, TOKEN_INFORMATION_CLASS c
     switch (class)
     {
     case TokenUser:
+        if (localsystem_sid)
+        {
+            static const struct sid local_system_sid = { SID_REVISION, 1, SECURITY_NT_AUTHORITY, { SECURITY_LOCAL_SYSTEM_RID } };
+            DWORD sid_len = offsetof( struct sid, sub_auth[local_system_sid.sub_count] );
+            TOKEN_USER *tuser;
+            PSID sid;
+
+            if (retlen) *retlen = sid_len + sizeof(TOKEN_USER);
+            if (sid_len + sizeof(TOKEN_USER) > length)
+            {
+                status = STATUS_BUFFER_TOO_SMALL;
+            }
+            else
+            {
+                tuser = info;
+                sid = tuser + 1;
+                tuser->User.Sid = sid;
+                tuser->User.Attributes = 0;
+                memcpy( sid, &local_system_sid, sid_len );
+            }
+            break;
+        }
         SERVER_START_REQ( get_token_sid )
         {
             TOKEN_USER *tuser = info;
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index e5b0adf8898..71853073bfd 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -236,6 +236,8 @@ extern pthread_mutex_t fd_cache_mutex;
 extern struct _KUSER_SHARED_DATA *user_shared_data;
 extern ULONG process_cookie;
 
+extern BOOL localsystem_sid;
+
 extern void init_environment(void);
 extern void init_startup_info(void);
 extern void *create_startup_info( const UNICODE_STRING *nt_image, ULONG process_flags,
