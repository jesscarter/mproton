From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alexander=20Thei=C3=9Fen?= <alex@theissen.io>
Date: Fri, 23 Oct 2026 13:31:27 +0800
Subject: [PATCH 10/16] ntdll: Support QUEUE_USER_APC_CALLBACK_DATA_CONTEXT on
 ARM64.

The arm64 call_user_apc_dispatcher() ignored the flag and passed the
raw second argument, so APCs queued with it got the parameter where they
expect an APC_CALLBACK_DATA pointer. Build the callback data in the APC
stack layout as the x86_64 version does, with ContextRecord pointing to
the context on the stack. The ARM64EC dispatcher converts that context
for x64 code, so point ContextRecord at the converted context there.

(cherry picked from commit 0564227b2baf5135b2e4e4db430eec0ff3177ca2)
---
 dlls/ntdll/signal_arm64ec.c    |  4 ++++
 dlls/ntdll/unix/signal_arm64.c | 18 ++++++++++++++----
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 3e9300040a5..d9084a39928 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -1363,10 +1363,14 @@ static void __attribute__((used)) dispatch_apc( void (CALLBACK *func)(ULONG_PTR,
                                                 ULONG_PTR arg1, ULONG_PTR arg2, ULONG_PTR arg3,
                                                 BOOLEAN alertable, ARM64_NT_CONTEXT *arm_ctx )
 {
+    /* with QUEUE_USER_APC_CALLBACK_DATA_CONTEXT, arg2 points to the callback data after the context */
+    APC_CALLBACK_DATA *callback_data = (APC_CALLBACK_DATA *)(arm_ctx + 1);
     union ARM64EC_NT_XCONTEXT context;
     CONTEXT_EX *xctx;
+
     RtlInitializeExtendedContext( &context, ctx_flags_arm_to_x64( arm_ctx->ContextFlags), &xctx );
     context_arm_to_x64( &context.context, arm_ctx );
+    if (arg2 == (ULONG_PTR)callback_data) callback_data->ContextRecord = &context.context.AMD64_Context;
     func( arg1, arg2, arg3, &context.context.AMD64_Context );
     NtContinue( &context.context.AMD64_Context, alertable );
 }
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
index c18e6507f6c..90c6a34d325 100644
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -173,10 +173,12 @@ struct apc_stack_layout
     ULONG64              alertable;      /* 020 */
     ULONG64              align;          /* 028 */
     CONTEXT              context;        /* 030 */
-    ULONG64              redzone[2];     /* 3c0 */
+    APC_CALLBACK_DATA    callback_data;  /* 3c0 */
+    ULONG64              redzone[2];     /* 3e0 */
 };
 C_ASSERT( offsetof(struct apc_stack_layout, context) == 0x30 );
-C_ASSERT( sizeof(struct apc_stack_layout) == 0x3d0 );
+C_ASSERT( offsetof(struct apc_stack_layout, callback_data) == 0x3c0 );
+C_ASSERT( sizeof(struct apc_stack_layout) == 0x3f0 );
 
 /* stack layout when calling KiUserCallbackDispatcher */
 struct callback_stack_layout
@@ -795,7 +797,7 @@ NTSTATUS call_user_apc_dispatcher( CONTEXT *context, unsigned int flags, ULONG_P
     ULONG64 sp = context ? context->Sp : frame->sp;
     struct apc_stack_layout *stack;
 
-    if (flags) FIXME( "flags %#x are not supported.\n", flags );
+    if (flags & ~SERVER_USER_APC_CALLBACK_DATA_CONTEXT) FIXME( "flags %#x are not supported.\n", flags );
 
     sp &= ~15;
     stack = (struct apc_stack_layout *)sp - 1;
@@ -812,7 +814,15 @@ NTSTATUS call_user_apc_dispatcher( CONTEXT *context, unsigned int flags, ULONG_P
     }
     stack->func      = func;
     stack->args[0]   = arg1;
-    stack->args[1]   = arg2;
+    if (flags & SERVER_USER_APC_CALLBACK_DATA_CONTEXT)
+    {
+        stack->callback_data.ContextRecord = &stack->context;
+        stack->callback_data.Parameter = arg2;
+        stack->callback_data.Reserved0 = 0;
+        stack->callback_data.Reserved1 = 0;
+        stack->args[1] = (ULONG_PTR)&stack->callback_data;
+    }
+    else stack->args[1] = arg2;
     stack->args[2]   = arg3;
     stack->alertable = TRUE;
 
