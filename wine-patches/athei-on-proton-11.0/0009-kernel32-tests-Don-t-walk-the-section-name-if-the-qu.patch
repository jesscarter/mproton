From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alexander=20Thei=C3=9Fen?= <alex@theissen.io>
Date: Fri, 23 Oct 2026 12:51:35 +0800
Subject: [PATCH 09/16] kernel32/tests: Don't walk the section name if the
 query fails in test_Wow64Transition.

The name buffer is not filled when the query fails, and the test went on
to walk it, which faulted and ended the kernel32:loader run before
test_Loader. Return after the failed check.

(cherry picked from commit 36c5c8ceef357815d4885fc4772e5224f159366e)
---
 dlls/kernel32/tests/loader.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/dlls/kernel32/tests/loader.c b/dlls/kernel32/tests/loader.c
index 529b9de870d..0b9bfea1d9a 100644
--- a/dlls/kernel32/tests/loader.c
+++ b/dlls/kernel32/tests/loader.c
@@ -4778,6 +4778,7 @@ static void test_Wow64Transition(void)
     status = NtQueryVirtualMemory(GetCurrentProcess(), *pWow64Transition,
                                   MemoryMappedFilenameInformation, name, sizeof(buffer), NULL);
     ok(!status, "got %#lx\n", status);
+    if (status) return;
     filepart = name->SectionFileName.Buffer + name->SectionFileName.Length / sizeof(WCHAR);
     while (*filepart != '\\') --filepart;
     ok(!wcsnicmp(filepart, L"\\wow64cpu.dll", wcslen(L"\\wow64cpu.dll")), "got file name %s\n",
