#!/bin/bash
# Start the mproton Library server (if it isn't already running) and open it in the browser.
# Usage: library/mproton-library [--port N] [--no-browser]
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The launcher is tested with Homebrew's python3; /usr/bin/python3 (Xcode CLT) is the fallback.
py="${MPROTON_PYTHON:-}"
if [ -z "$py" ]; then
    for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
        if command -v "$c" >/dev/null 2>&1; then py="$(command -v "$c")"; break; fi
    done
fi
exec "$py" -I "$here/mproton_library.py" "$@"
